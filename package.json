{
  "name": "generic-resource-ui",
  "version": "0.1.2",
  "scripts": {
    "preinstall": "npx only-allow npm",
    "start": "ng serve --serve-path=/ui/generic-resource --ssl --ssl-cert=certs/localhost+2.pem --ssl-key=certs/localhost+2-key.pem",
    "build": "ng build",
    "test": "npm run test:unit",
    "test:unit": "jest --detectOpenHandles",
    "test:cov": "jest --runInBand --coverage --silent",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write --list-different .",
    "check-format": "prettier --check .",
    "postinstall": "husky || true"
  },
  "lint-staged": {
    "*.{ts,css,md,html,json,scss}": "prettier -w",
    "*.ts": "eslint --cache"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/elements": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@apollo/client": "^4.2.11",
    "@fundamental-ngx/cdk": "^0.66.0",
    "@fundamental-ngx/core": "^0.66.0",
    "@fundamental-ngx/datetime-adapter": "^0.66.0",
    "@fundamental-ngx/i18n": "^0.66.0",
    "@fundamental-ngx/platform": "^0.66.0",
    "@fundamental-styles/common-css": "^0.42.0",
    "@luigi-project/client": "^2.22.1",
    "@luigi-project/client-support-angular": "^22.0.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@sap-theming/theming-base-content": "^11.36.5",
    "apollo-angular": "^14.0.0",
    "deepmerge": "4.3.1",
    "fundamental-styles": "0.42.0",
    "gql-query-builder": "^4.0.0",
    "graphql": "17.0.2",
    "graphql-sse": "2.6.3",
    "monaco-editor": "^0.57.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "yaml": "^2.7.0",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@openmfp/config-prettier": "0.9.3",
    "@openmfp/eslint-config-typescript": "0.7.15",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-jasmine2": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-mock-extended": "4.0.1",
    "jest-preset-angular": "17.0.2",
    "lint-staged": "17.6.0",
    "ng-lint-staged": "12.0.4",
    "ng-mocks": "14.17.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.58.0"
  },
  "type": "module",
  "overrides": {
    "picomatch@<3": "~2.3.2",
    "picomatch@>=4": "~4.0.4",
    "flatted": "~3.4.2",
    "tar": "~7.5.13",
    "immutable": "~5.1.5",
    "minimatch@<4": "~3.1.4",
    "minimatch@>=9": "~9.0.7",
    "dompurify": "~3.4.0",
    "@tootallnate/once": "~3.0.1",
    "@modelcontextprotocol/sdk": "~1.32.0"
  }
}
